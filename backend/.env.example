# Google OAuth "Web application" client (Google Cloud > Google Auth Platform > Clients)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
FRONTEND_URL=http://localhost:3000

# MongoDB (local docker-compose by default, Atlas in production)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=umassradar

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-me

# Set to true when served over https
COOKIE_SECURE=false

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# used when the main model is overloaded
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

ENABLE_SCHEDULER=true
